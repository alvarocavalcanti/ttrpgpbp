{
  "plugins": ["react", "jsx-a11y", "vitest"],
  "rules": {
    "react/button-has-type": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "vitest/expect-expect": "error",
    "typescript/no-explicit-any": "error",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react-hooks/exhaustive-deps": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    // Decision (b) from issue #567: React Compiler is NOT adopted — manual
    // memoization, derive-from-fetch effects, and stability refs are the house
    // style, so the compiler rules that contradict them stay off. Purity,
    // globals, and immutability stay ON as real regression signal. Re-open if
    // the compiler is ever adopted (option (a)).
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/preserve-manual-memoization": "off"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.test.tsx", "*.spec.ts", "src/test/**", "tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "group": ["**/lib/supabase", "**/lib/supabase.*"],
            "message": "Queries live in hooks (issue #403 ARCH-1) — use the feature's hook instead of importing the Supabase client."
          }]
        }]
      }
    },
    {
      // Oxlint ignores "!" negation globs in override files, so tests are
      // excluded by turning the rule back off in a later override (later wins).
      "files": ["src/**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": "off",
        // Deliberate test-harness patterns: probes writing to an outer
        // variable during render (e.g. shared.isLoading, currentSearch).
        "react/immutability": "off",
        "react/globals": "off"
      }
    },
    {
      // Known false positive: Vitest supports the expect(actual, message)
      // form; the diagnostic second arg is kept on failure output.
      "files": ["scripts/**/*.test.ts"],
      "rules": {
        "vitest/valid-expect": "off"
      }
    },
    {
      // Deliberate: the role="log" scroll region stays keyboard-focusable
      // (tabIndex={0}) so keyboard users can scroll it; asserted in
      // MessageList.test.tsx.
      "files": ["src/features/chat/MessageList.tsx"],
      "rules": {
        "jsx-a11y/no-noninteractive-tabindex": "off"
      }
    }
  ]
}
