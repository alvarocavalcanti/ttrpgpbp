{
  "plugins": ["react", "jsx-a11y", "vitest"],
  "rules": {
    "react/button-has-type": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "vitest/expect-expect": "error",
    "typescript/no-explicit-any": "error",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react-hooks/exhaustive-deps": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.test.tsx", "*.spec.ts", "src/test/**", "tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "group": ["**/lib/supabase", "**/lib/supabase.*"],
            "message": "Queries live in hooks (issue #403 ARCH-1) — use the feature's hook instead of importing the Supabase client."
          }]
        }]
      }
    },
    {
      // Oxlint ignores "!" negation globs in override files, so tests are
      // excluded by turning the rule back off in a later override (later wins).
      "files": ["src/**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
