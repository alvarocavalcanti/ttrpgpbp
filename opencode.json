      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "allow"
    },
    {
      "action": "shell",
