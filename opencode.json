{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "agents": {
    "plan": {
      "model": {
        "providerID": "opencode-go",
        "model": "deepseek-v4-flash-vision-exp"
      }
    },
    "build": {
      "model": {
        "providerID": "opencode-go",
        "model": "deepseek-v4.1-flash"
      }
    },
    "cavecrew-builder": {
      "mode": "subagent"
    },
    "cavecrew-investigator": {
      "mode": "subagent"
    },
    "cavecrew-reviewer": {
      "mode": "subagent"
    }
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
