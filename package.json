{
  "name": "rolebypost",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:md": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\"",
    "spellcheck": "cspell \"src/**/*.{ts,tsx}\" \"*.md\" \"docs/**/*.md\"",
    "check:types-staged": "sh scripts/git/check-types-staged.sh",
    "check:migration-order": "sh scripts/git/check-migration-order.sh",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "supabase:up": "sh scripts/supabase/up.sh",
    "supabase:down": "sh scripts/supabase/down.sh",
    "supabase:reset": "sh scripts/supabase/reset.sh",
    "supabase:prune": "sh scripts/supabase/prune.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/crimson-pro": "^5.3.0",
    "@sentry/react": "^10.75.1",
    "@sentry/tracing": "^7.120.4",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.6.1",
    "cspell": "^10.3.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "markdownlint-cli2": "^0.23.3",
    "msw": "^2.15.0",
    "oxlint": "^1.84.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
